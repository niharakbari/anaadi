# ─── Server ───────────────────────────────────────────────────────────────────
# Core server configuration and CORS settings
PORT=3200
CLIENT_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Connection credentials for the primary database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=imaginary

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT signing secrets and admin bootstrap credentials
JWT_SECRET=your_jwt_signing_secret_key
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@anaadi.com
ADMIN_PASSWORD=your_secure_admin_password_placeholder

# ─── Uploads ──────────────────────────────────────────────────────────────────
# Storage paths and constraints for user uploads
MAX_FILES_PER_UPLOAD=100
DESIGN_LIBRARY_DIRECTORY=uploads/design_library
QUERY_UPLOAD_DIRECTORY=uploads/query_uploads

# ─── AI Model ─────────────────────────────────────────────────────────────────
# Base directory for all downloaded AI models and the active retrieval model
AI_MODELS_DIRECTORY=ai-models
AI_MODEL=siglip

# ─── Indexing ─────────────────────────────────────────────────────────────────
# Directory for storing vector indices and verification features
INDEX_DIRECTORY=../indexes

# ─── Search ───────────────────────────────────────────────────────────────────
# (Reserved for future search-specific limits or thresholds)
SEARCH_DEFAULT_TOP_K=10

# ─── Preprocessing ────────────────────────────────────────────────────────────
# Toggles for the dealer-photo preprocessing pipeline
PREPROCESSING_ENABLED=true
PREPROCESSING_QUALITY=true
PREPROCESSING_ENHANCEMENT=true
PREPROCESSING_SEGMENTATION=true

# ─── Verification ─────────────────────────────────────────────────────────────
# Post-retrieval verification pipeline (e.g. Dense ViT Patch Matcher)
VERIFICATION_ENABLED=true
VERIFICATION_MODEL=vit-patch
VERIFICATION_CANDIDATE_COUNT=10
VERIFICATION_EMBEDDING_WEIGHT=0.7
VERIFICATION_GEOMETRY_WEIGHT=0.3
VERIFICATION_MIN_SCORE=5

# ─── Logging ──────────────────────────────────────────────────────────────────
# Application logging levels (info, debug, warn, error)
LOG_LEVEL=info
